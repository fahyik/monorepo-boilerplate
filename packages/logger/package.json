{
  "name": "@packagename/logger",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc -w",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "preset": "@packagename/jest-presets/node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "NodeNext"
          }
        }
      ]
    }
  },
  "volta": {
    "extends": "../../package.json"
  },
  "devDependencies": {
    "@packagename/eslint-config": "*",
    "@packagename/jest-presets": "*",
    "@packagename/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "eslint": "^10.10.0",
    "jest": "^30.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "logform": "^2.7.0",
    "winston": "^3.17.0",
    "morgan": "^1.10.1"
  }
}
